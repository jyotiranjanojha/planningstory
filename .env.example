# ======================================================================
# INTEL CORPORATE PROXY CONFIGURATION
# ======================================================================
http_proxy=http://proxy-dmz.intel.com:912
https_proxy=http://proxy-dmz.intel.com:912
no_proxy=localhost,127.0.0.0/8,10.0.0.0/8,.intel.com
HTTP_PROXY=http://proxy-dmz.intel.com:912
HTTPS_PROXY=http://proxy-dmz.intel.com:912
NO_PROXY=localhost,127.0.0.0/8,10.0.0.0/8,.intel.com

# ======================================================================
# LLM PROVIDER CONFIGURATION
# ======================================================================
# Choose which LLM provider to use: 'ollama', 'snowflake_cortex', 'nollama', 'openai', 'azure', 'anthropic', 'custom', or 'openvino'
LLM_PROVIDER=ollama

# ======================================================================
# SNOWFLAKE CORTEX CONFIGURATION (Recommended for Rancher / Container Deployments)
# Set LLM_PROVIDER=snowflake_cortex to use Snowflake Cortex REST Inference API
# ======================================================================
# SNOWFLAKE_CORTEX_MODE=rest                         # 'rest' (PAT/JWT in Rancher) or 'sql' (SNOWFLAKE.CORTEX.COMPLETE via SSO)
# SNOWFLAKE_CORTEX_ACCOUNT=your-org-account
# SNOWFLAKE_CORTEX_BASE_URL=https://your-org-account.snowflakecomputing.com
# SNOWFLAKE_CORTEX_TOKEN=your-snowflake-programmatic-access-token
# SNOWFLAKE_CORTEX_TOKEN_TYPE=PROGRAMMATIC_ACCESS_TOKEN
# SNOWFLAKE_CORTEX_MODEL=claude-3-5-sonnet
# SNOWFLAKE_CORTEX_MODELS=claude-3-5-sonnet,claude-3-7-sonnet,llama3.3-70b,mistral-large2,snowflake-arctic
# For quick local SQL testing (SNOWFLAKE_CORTEX_MODE=sql with Intel SSO browser login):
# SNOWFLAKE_USER=your.name@intel.com
# SNOWFLAKE_AUTHENTICATOR=externalbrowser
# SNOWFLAKE_ROLE=
# SNOWFLAKE_WAREHOUSE=

# ======================================================================
# OLLAMA CONFIGURATION (Local Ollama server with OpenAI-compatible v1 API)
# ======================================================================
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:latest
OLLAMA_JUDGE_MODEL=qwen2.5-coder:latest
OLLAMA_VISION_MODEL=gemma3:latest
OLLAMA_SQL_MODEL=qwen2.5-coder:latest

# ======================================================================
# NOLLAMA CONFIGURATION (Local OpenAI-compatible v1 API)
# Uncomment and set LLM_PROVIDER=nollama when running NoLlama locally
# ======================================================================
# NOLLAMA_BASE_URL=http://localhost:8000
# NOLLAMA_MODEL=Qwen2.5-Coder-7B-Instruct@GPU
# NOLLAMA_JUDGE_MODEL=Qwen2.5-Coder-7B-Instruct@GPU
# NOLLAMA_VISION_MODEL=Qwen2.5-Coder-7B-Instruct@GPU

# ======================================================================
# OPENAI CONFIGURATION (Production)
# Use this to connect to OpenAI's API
# ======================================================================
# OPENAI_API_KEY=sk-YOUR_API_KEY_HERE
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o
# OPENAI_JUDGE_MODEL=gpt-4o
# OPENAI_VISION_MODEL=gpt-4o

# ======================================================================
# ANTHROPIC CONFIGURATION (Claude models)
# Uses x-api-key header (not Bearer token)
# ======================================================================
# ANTHROPIC_API_KEY=sk-ant-YOUR_API_KEY_HERE
# ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
# ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
# ANTHROPIC_JUDGE_MODEL=claude-3-5-haiku-20241022
# ANTHROPIC_VISION_MODEL=claude-3-5-sonnet-20241022

# ======================================================================
# AZURE OPENAI CONFIGURATION
# Different URL format: no /v1/ prefix, uses deployment name, api-key header
# ======================================================================
# AZURE_OPENAI_API_KEY=your-azure-api-key
# AZURE_OPENAI_ENDPOINT=https://myresource.openai.azure.com
# AZURE_OPENAI_DEPLOYMENT=gpt-4o-deployment
# AZURE_OPENAI_API_VERSION=2024-02-01
# AZURE_OPENAI_JUDGE_DEPLOYMENT=gpt-4o-deployment
# AZURE_OPENAI_VISION_DEPLOYMENT=gpt-4o-deployment

# ======================================================================
# CUSTOM LLM PROVIDER (Any OpenAI-compatible API, e.g. Intel Model Garden)
# Accepts root URL, /v1, or full /v1/chat/completions URL automatically.
# ======================================================================
# CUSTOM_LLM_BASE_URL=https://models-gcp.intel.com
# CUSTOM_LLM_API_KEY=sk-YOUR_MODEL_GARDEN_KEY
# CUSTOM_LLM_MODEL=claude-opus-4-8
# CUSTOM_LLM_MODELS=claude-opus-4-8,claude-sonnet-4-5

# ======================================================================
# OPENVINO CONFIGURATION (Optimized local inference with latency hints)
# Use this for high-performance local inference with GPU acceleration
# Requirements: openvino_genai package + quantized model files
# ======================================================================
# OPENVINO_MODEL_PATH=C:\Users\jojha\OneDrive - Intel Corporation\Documents\NoLlama\model
# OPENVINO_DEVICE=GPU  # GPU, CPU, NPU
# OPENVINO_PERFORMANCE_HINT=LATENCY  # LATENCY or THROUGHPUT
# OPENVINO_NUM_STREAMS=1  # For THROUGHPUT mode
# OPENVINO_MODEL=deepseek-r1-distill-qwen-7b
# OPENVINO_JUDGE_MODEL=deepseek-r1-distill-qwen-7b
# OPENVINO_VISION_MODEL=deepseek-r1-distill-qwen-7b# OPENVINO_EMBEDDING_MODEL_PATH=./embedding_model/bge-small-en-v1.5
# OPENVINO_RERANKER_MODEL_PATH=./embedding_model/bge-reranker-base
# OPENVINO_RERANKER_ENABLED=false  # Set to true after exporting reranker model
# OPENVINO_RERANKER_TOP_N=3

# ======================================================================
# PLANNING DATA PATHS (Shared File Path / Network Share / Rancher Mount)
# ======================================================================
# Option A: Point to a shared root folder containing by_input/ and by_output/
#   Windows UNC example: PLANNING_DATA_DIR=\\intel-share.intel.com\ifsp\snapshots
#   Linux / Rancher mount example: PLANNING_DATA_DIR=/mnt/planning-data
# PLANNING_DATA_DIR=
#
# Option B: Override input and output folders independently (takes precedence over PLANNING_DATA_DIR)
#   Windows UNC examples:
#     BY_INPUT_DIR=\\intel-share.intel.com\ifsp\by_input
#     BY_OUTPUT_DIR=\\intel-share.intel.com\ifsp\by_output
#   Linux / Rancher mount examples:
#     BY_INPUT_DIR=/mnt/planning-data/by_input
#     BY_OUTPUT_DIR=/mnt/planning-data/by_output
# BY_INPUT_DIR=
# BY_OUTPUT_DIR=
#
# Local snapshot cache for remote SMB/UNC or NFS shares (auto = enabled for UNC paths):
# PLANNING_DATA_CACHE_ENABLED=auto
# PLANNING_DATA_CACHE_DIR=data/snapshot_cache
# Zero-touch background check interval in seconds (default 300s = 5 min; 0 = disabled):
# PLANNING_DATA_REFRESH_INTERVAL_SECS=300

# ======================================================================
# RAG DATA SOURCE
# ======================================================================
# RAG_SOURCE=csv          # Default: read from by_input/ and by_output/
# RAG_SOURCE=snowflake    # Read from Snowflake tables
# RAG_MAX_ROWS_PER_FILE=500

# ======================================================================
# SNOWFLAKE CONFIGURATION (used when RAG_SOURCE=snowflake)
# ======================================================================
# SNOWFLAKE_ACCOUNT=your-account.snowflakecomputing.com
# SNOWFLAKE_USER=your-user
# SNOWFLAKE_PASSWORD=your-password
# SNOWFLAKE_DATABASE=IFSP_DB
# SNOWFLAKE_SCHEMA=PLANNING
# SNOWFLAKE_WAREHOUSE=COMPUTE_WH
# SNOWFLAKE_ROLE=SYSADMIN
# ======================================================================
# JUDGE/REVIEW LLM SETTINGS
# ======================================================================
JUDGE_LLM_ENABLED=true

# ======================================================================
# OLLAMA CONFIGURATION (Deprecated, use LLM_PROVIDER instead)
# These are kept for backward compatibility
# ======================================================================
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=gemma3:latest
# OLLAMA_JUDGE_MODEL=llama3.1:8b
# OLLAMA_JUDGE_ENABLED=true
# OLLAMA_VISION_MODEL=gemma3:latest

# ======================================================================
# APP / AUTH CONFIGURATION
# ======================================================================
PORT=3000
HOST=0.0.0.0
NODE_ENV=development
APP_NAME=IFSP Story
PYTHON_BASE_URL=http://127.0.0.1:8001
LOG_LEVEL=info

# Microsoft Entra ID / Azure App Registration
# Set these values per environment (dev/test/prod)
AZURE_TENANT_ID=your-tenant-id
AZURE_CLIENT_ID=your-client-id
AZURE_CLIENT_SECRET=your-client-secret
AZURE_REDIRECT_URI=http://localhost:8001/auth/callback
AZURE_GROUP_IDS=group-guid-1,group-guid-2

# ======================================================================
# OTHER CONFIGURATION
# ======================================================================
OLLAMA_BASE_URL=http://localhost:8000
