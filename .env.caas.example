# ======================================================================
# Intel Foundry Planning Story — CaaS / Rancher Single-File Config
# ======================================================================
# Copy this file to `.env.caas` (gitignored), fill in your values, and sync
# it into your Rancher namespace in one command:
#
#   kubectl -n if-pdh-ai-assist create secret generic planningstory-secrets \
#     --from-env-file=.env.caas --dry-run=client -o yaml | kubectl apply -f -
#   kubectl -n if-pdh-ai-assist rollout restart deploy/planningstory
# ======================================================================

# ── LLM Provider (Recommended for CaaS: Intel Model Garden via 'custom') ──
LLM_PROVIDER=custom
LLM_TEMPERATURE=0.1
CUSTOM_LLM_BASE_URL=https://models-gcp.intel.com
CUSTOM_LLM_API_KEY=sk-REPLACE_WITH_MODEL_GARDEN_KEY
CUSTOM_LLM_MODEL=claude-opus-4-8
CUSTOM_LLM_MODELS=claude-opus-4-8,claude-sonnet-4-5
JUDGE_LLM_ENABLED=false

# ── Alternative: Snowflake Cortex REST API (uncomment to switch) ──────────
# LLM_PROVIDER=snowflake_cortex
# SNOWFLAKE_CORTEX_MODE=rest
# SNOWFLAKE_CORTEX_ACCOUNT=XD14286-IFCDWDEV2
# SNOWFLAKE_CORTEX_TOKEN=REPLACE_WITH_SNOWFLAKE_PAT_OR_JWT
# SNOWFLAKE_CORTEX_TOKEN_TYPE=PROGRAMMATIC_ACCESS_TOKEN
# SNOWFLAKE_CORTEX_MODEL=claude-sonnet-4-5

# ── Shared File Path (mounted at /mnt/planning-data via shared-storage-smb.yaml) ──
PLANNING_DATA_DIR=/mnt/planning-data
PLANNING_DATA_CACHE_ENABLED=true
PLANNING_DATA_CACHE_DIR=/app/data/snapshot_cache
PLANNING_DATA_REFRESH_INTERVAL_SECS=300

# ── Microsoft Entra ID / Azure App Registration ───────────────────────────
AZURE_TENANT_ID=REPLACE_WITH_TENANT_ID
AZURE_CLIENT_ID=REPLACE_WITH_CLIENT_ID
AZURE_CLIENT_SECRET=REPLACE_WITH_CLIENT_SECRET
AZURE_REDIRECT_URI=https://planningstory.intel.com/auth/callback
AZURE_REQUIRE_GROUP_CHECK=false
# AZURE_GROUP_IDS=group-guid-1,group-guid-2
